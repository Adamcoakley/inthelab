---
import Base from './Base.astro';
import Quiz from '../components/Quiz.astro';
const { lab } = Astro.props;   // the full entry from the labs collection
const d = lab.data;
const typeColor = { lab: 'var(--accent)', concept: 'var(--ok)', challenge: 'var(--cost)' };
---
<Base title={`Lab ${d.number} · ${d.title}`} path="/roadmap">
  <div class="lab-wrap">
    <article class="lab-main">
      <div class="lab-crumb mono">roadmap / phase {d.phase} / <span style="color:var(--accent)">lab {d.number}</span></div>
      <h1>{d.title}</h1>
      <div class="lab-meta">
        <span class="meta-pill" style={`color:${typeColor[d.type]}`}>◆ {d.type}</span>
        <span class="meta-pill">◷ {d.time}</span>
        <span class="meta-pill" style="color:var(--cost)">$ {d.cost}</span>
        {d.buildsOn && <span class="meta-pill">↳ builds on {d.buildsOn}</span>}
      </div>

      <!-- the lab body (Markdown), wrapped so {{name}} tokens get swapped -->
      <div class="lab-body" data-personalize>
        <slot />
      </div>

      <Quiz questions={d.questions} />

      <div class="lab-foot">
        <a href="/roadmap" class="btn-ghost">← Back to roadmap</a>
      </div>
    </article>
  </div>

  <style>
    .lab-wrap{max-width:820px;margin:0 auto;padding:32px 24px 40px}
    .lab-crumb{font-size:12px;color:var(--ink-faint);margin-bottom:14px}
    .lab-main h1{font-size:32px;margin-bottom:12px}
    .lab-meta{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:26px}
    .meta-pill{font-size:12.5px;font-family:'JetBrains Mono',monospace;padding:5px 11px;border-radius:8px;background:var(--panel);border:1px solid var(--line);color:var(--ink-dim);display:flex;align-items:center;gap:6px}

    /* Markdown styling inside a lab */
    .lab-body :global(h2){font-size:21px;margin:30px 0 12px}
    .lab-body :global(h3){font-size:18px;margin:24px 0 9px}
    .lab-body :global(p){color:var(--ink-dim);font-size:15.5px;margin:11px 0;line-height:1.65}
    .lab-body :global(ul),.lab-body :global(ol){color:var(--ink-dim);font-size:15.5px;margin:11px 0;padding-left:24px;line-height:1.7}
    .lab-body :global(li){margin:5px 0}
    .lab-body :global(strong){color:var(--ink)}
    .lab-body :global(code){font-family:'JetBrains Mono',monospace;font-size:13px;background:var(--panel);border:1px solid var(--line-2);border-radius:5px;padding:1px 6px;color:var(--ink)}
    .lab-body :global(pre){background:#0A0D24;border:1px solid var(--line);border-radius:11px;padding:16px;overflow-x:auto;margin:14px 0}
    .lab-body :global(pre code){background:none;border:none;color:#c7d0e8;padding:0;font-size:13.5px}
    .lab-body :global(blockquote){border-left:3px solid var(--accent);background:var(--panel);border-radius:0 9px 9px 0;padding:12px 16px;margin:14px 0;color:var(--ink-dim);font-size:14.5px}
    .lab-body :global(blockquote.note){border-left-color:var(--accent)}
    .lab-body :global(hr){border:none;border-top:1px solid var(--line);margin:26px 0}
    .lab-foot{margin-top:32px;padding-top:22px;border-top:1px solid var(--line)}

    /* screenshots / images added in Markdown with ![alt](/images/x.png) */
    .lab-body :global(img){display:block;max-width:100%;height:auto;border:1px solid var(--line);border-radius:11px;margin:16px 0;box-shadow:var(--sh-sm)}
    /* if you write an image inside a <figure>, the <figcaption> becomes a caption */
    .lab-body :global(figure){margin:16px 0}
    .lab-body :global(figure img){margin:0}
    .lab-body :global(figcaption){font-size:12.5px;color:var(--ink-faint);text-align:center;margin-top:7px;font-family:'JetBrains Mono',monospace}

    /* callout boxes usable from Markdown via <div class="callout ..."> */
    .lab-body :global(.callout){border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:9px;padding:13px 16px;margin:16px 0;font-size:14.5px;color:var(--ink-dim);background:var(--panel)}
    .lab-body :global(.callout.why){border-left-color:var(--accent)}
    .lab-body :global(.callout.break){border-left-color:var(--amber);background:color-mix(in srgb,var(--amber) 6%,transparent)}
    .lab-body :global(.callout.break b){color:var(--amber)}
    .lab-body :global(.callout.aha){border-left-color:var(--accent);background:var(--accent-soft)}
    .lab-body :global(.callout.shot){border-style:dashed;border-left-style:dashed;background:var(--panel);text-align:center;font-family:'JetBrains Mono',monospace;font-size:12.5px;color:var(--ink-faint)}
  </style>
</Base>
