---
import { readFileSync } from 'node:fs';
import Base from '../layouts/Base.astro';

// Inline an SVG so its colours follow the theme.
const svg = (name) => readFileSync(`${process.cwd()}/public/images/style/${name}.svg`, 'utf8');
const lab = (name) => readFileSync(`${process.cwd()}/public/images/labs/${name}.svg`, 'utf8');

const colours = [
  { group: 'Accents', note: "Close to AWS's own category colours. In concept diagrams, each idea gets one of these so you can tell them apart at a glance.", items: [
    ['net', 'Violet', 'networking: VPC, gateways, route tables'],
    ['cmp', 'Orange', 'compute: servers, AMIs'],
    ['priv', 'Teal', 'private subnets, the Region border'],
    ['pub', 'Green', 'public subnets, storage like S3'],
    ['sec', 'Red', 'IAM and security services only'],
    ['db', 'Magenta', 'databases'],
  ]},
  { group: 'You', note: "The one colour that isn't from AWS: the site's accent blue, for things that are yours, or your job.", items: [
    ['you', 'Yours', 'your laptop, your app, your responsibilities'],
  ]},
  { group: 'Status', note: 'Always shown with a mark, never colour alone.', items: [
    ['ok', 'Allowed', 'tick mark, working path'],
    ['bad', 'Blocked', 'crossed circle, dashed path'],
  ]},
  { group: 'Neutrals', note: 'Text, lines and backgrounds. These are what change most between themes.', items: [
    ['ink', 'Ink', 'labels, outlines, general icons'],
    ['sub', 'Secondary', 'captions, IP addresses'],
    ['faint', 'Faint', 'inactive, not built yet'],
    ['surface', 'Surface', 'cards inside a diagram'],
    ['panel', 'Panel', 'diagram background'],
  ]},
];
// light / dark, read straight from the diagram library's palette
const hex = {
  ink: ['#1F2A37', '#E6EBF5'], sub: ['#5F6B7A', '#9AA7BD'], faint: ['#A7B1BE', '#44526B'],
  surface: ['#F5F7FA', '#141E2C'], panel: ['#FFFFFF', '#0C1220'], net: ['#735ED1', '#8B7BF0'],
  cmp: ['#D16100', '#F5A524'], pub: ['#51850E', '#A3CF4A'], priv: ['#0A847F', '#22C7B8'],
  sec: ['#C43E45', '#F25A6E'], db: ['#A14DA7', '#E05BE6'], you: ['#396ED6', '#7AA2F7'], ok: ['#178950', '#34D399'], bad: ['#C03D69', '#F2739D'],
};
const tint = { net: 'nettint', cmp: 'cmptint', priv: 'privtint', pub: 'pubtint', sec: 'sectint', db: 'dbtint', you: 'youtint', ok: 'oktint', bad: 'badtint' };
const aws = ['ec2', 'igw', 'nat', 'router', 'nacl', 'alb', 'ami', 'ebs', 's3', 'role'];
const general = ['client', 'user', 'globe', 'server', 'firewall', 'phone', 'router-home', 'packet'];
const groups = ['g-cloud', 'g-region', 'g-vpc', 'g-az', 'g-public', 'g-private', 'g-sg', 'g-asg'];
const marks = ['m-flow', 'm-ok', 'm-blocked', 'm-step'];
---
<Base title="Style guide · inthelab" path="/style-guide">
  <main class="sg wrap">
    <header class="sg-head">
      <h1>How inthelab draws things</h1>
      <p class="lede">Every diagram uses the same colours, icons and rules. Each one is a single file with two palettes: the original neon look in dark mode, and a version tuned for white in light mode. Switch themes at the top right to compare.</p>
    </header>

    <section>
      <h2>Colours mean something</h2>
      {colours.map((g) => (
        <div class="sg-block">
          <h3>{g.group}</h3>
          <p class="note">{g.note}</p>
          <div class="swatches">
            {g.items.map(([k, name, use]) => (
              <div class="swatch">
                <span class="chip" style={tint[k] ? `background:var(--dg-${tint[k]});border:2px solid var(--dg-${k})` : `background:var(--dg-${k})`}>{tint[k] && <b style={`color:var(--dg-${k}-text)`}>Aa</b>}</span>
                <div>
                  <div class="sw-name">{name}</div>
                  <div class="sw-use">{use}</div>
                  <div class="sw-hex mono">{hex[k][0]} <span>/</span> {hex[k][1]}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </section>

    <section>
      <h2>Assets</h2>
      <p class="note">Drawn once, reused everywhere. AWS services use the official icons. Everything else uses AWS's general icons, so the two families match.</p>

      <h3>AWS services</h3>
      <div class="tiles">{aws.map((n) => <div class="tile" set:html={svg(`assets/${n}`)} />)}</div>

      <h3>General</h3>
      <div class="tiles">{general.map((n) => <div class="tile" set:html={svg(`assets/${n}`)} />)}</div>

      <h3>Groups</h3>
      <div class="tiles wide">{groups.map((n) => <div class="tile" set:html={svg(`assets/${n}`)} />)}</div>

      <h3>Lines and marks</h3>
      <div class="tiles">{marks.map((n) => <div class="tile" set:html={svg(`assets/${n}`)} />)}</div>

      <h3>Two versions of a server</h3>
      <p class="note">The EC2 icon in architecture diagrams. The opened-up version when a lab needs to explain what's inside.</p>
      <div class="diagram" set:html={svg('assets/servers')} />
    </section>

    <section>
      <h2>Rules</h2>
      <ol class="rules">
        <li><b>A colour per idea.</b> Each separate thing in a diagram gets its own accent: a coloured border, a tinted fill and a title in the same colour. Architecture diagrams keep AWS's own colours for groups and icons.</li>
        <li><b>Red means a problem.</b> Blocked traffic, errors and bad practice. Security groups are drawn in neutral grey, because they're doing their job, not failing.</li>
        <li><b>Status needs a mark.</b> Allowed gets a tick, blocked gets a crossed circle and a dashed line. Never rely on green and red alone.</li>
        <li><b>Every label is monospace.</b> JetBrains Mono throughout, so the diagrams read like the terminal you're typing into.</li>
        <li><b>Two palettes, not one.</b> Dark mode uses the original neon colours. Light mode re-derives them for white at an even lightness, so no colour shouts or fades. Orange leans towards red there, because a darkened orange turns brown, and text uses a deeper shade than lines so it stays readable. The glow is dark-mode only.</li>
        <li><b>Light mode looks like the real thing.</b> In light mode, hardware is drawn as hardware: servers and devices in solid dark grey, buildings in concrete, the internet in blue. Accent colours are kept for meaning. Dark mode keeps the glowing schematic look.</li>
        <li><b>Current AWS icons.</b> Services such as EC2 and S3 use AWS's square service icons.</li>
        <li><b>Numbered steps only for sequences.</b> Use the step markers when the order matters, and explain each step in the lab text.</li>
        <li><b>Show only what the lab needs.</b> Leave out anything the learner hasn't met yet, or draw it faint.</li>
      </ol>
    </section>

    <section>
      <h2>Examples</h2>

      <h3>A concept, before AWS (Lab 0.1)</h3>
      <div class="diagram">
        <Fragment set:html={lab('00-01/server-anatomy')} />
        <div class="dcap">a colour per idea, tinted cards</div>
      </div>

      <h3>A concept, with AWS icons (Lab 3.1)</h3>
      <div class="diagram">
        <Fragment set:html={lab('03-01/what-you-choose')} />
        <div class="dcap">the same card style, with AWS icons inside</div>
      </div>

      <h3>An AWS architecture (Lab 4.4)</h3>
      <div class="diagram">
        <Fragment set:html={lab('04-04/arch-bastion')} />
        <div class="dcap">AWS groups and colours; security groups in neutral grey</div>
      </div>
    </section>

    <section>
      <h2>Screenshots</h2>
      <p class="note">Console screenshots stay in light mode, because that's what learners see in AWS. They get a frame, and are dimmed a little in dark mode so they don't glare.</p>
      <div class="lab-body">
        <figure class="screenshot">
          <img src="/images/labs/03-01/instance-details.png" alt="The instance details showing the public and private IPv4 addresses." />
        </figure>
      </div>
      <p class="note">See it all together on a <a href="/labs/99-01-diagram-style-example">sample lab page</a>.</p>
    </section>
  </main>

  <style>
    .sg{max-width:880px;padding-top:40px;padding-bottom:20px}
    .sg-head h1{font-size:34px;margin-bottom:10px}
    .lede{color:var(--ink-dim);font-size:16.5px;max-width:62ch}
    section{margin-top:44px}
    h2{font-size:23px;margin-bottom:6px}
    h3{font-size:16px;margin:26px 0 8px}
    .note{color:var(--ink-dim);font-size:14.5px;margin:4px 0 12px;max-width:68ch}
    .note a{color:var(--accent);text-decoration:underline;text-underline-offset:3px}
    .sg-block{margin-top:18px}
    .swatches{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px}
    .swatch{display:flex;gap:12px;align-items:flex-start;padding:12px;border:1px solid var(--line);border-radius:10px;background:var(--canvas-2)}
    .chip{width:34px;height:34px;border-radius:8px;flex:none;border:1px solid var(--line);display:grid;place-items:center;font:600 12px 'JetBrains Mono',monospace}
    .sw-name{font-weight:600;font-size:14px}
    .sw-use{color:var(--ink-dim);font-size:13px}
    .sw-hex{color:var(--ink-faint);font-size:11.5px;margin-top:3px}
    .sw-hex span{opacity:.5}
    .tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:10px}
    .tiles.wide{grid-template-columns:repeat(auto-fill,minmax(200px,1fr))}
    .tile{background:var(--dg-panel);border:1px solid var(--dg-border);border-radius:10px;padding:6px}
    .tile :global(svg){width:100%;height:auto;display:block}
    .sg :global(.diagram > svg.dg){margin:0}
    .rules{padding-left:22px;color:var(--ink-dim);font-size:15px;line-height:1.65}
    .rules li{margin:6px 0}
    .rules b{color:var(--ink)}
    @media (max-width:560px){.sg-head h1{font-size:28px}}
  </style>
</Base>
