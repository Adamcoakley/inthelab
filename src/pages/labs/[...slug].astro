---
import { getCollection, render } from 'astro:content';
import Lab from '../../layouts/Lab.astro';

// One page per lab file. Astro builds these all to static HTML at build time.
export async function getStaticPaths() {
  const labs = await getCollection('labs', ({ data }) => !data.draft);
  return labs.map((lab) => ({
    params: { slug: lab.id },
    props: { lab },
  }));
}

const { lab } = Astro.props;
const { Content } = await render(lab);
---
<Lab lab={lab}>
  <Content />
</Lab>
