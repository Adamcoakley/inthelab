---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const phases = [
  { n: 1, title: 'AWS Foundations', sub: 'Account, IAM, budget, and the addressing concepts everything leans on' },
  { n: 2, title: 'Build a Network', sub: 'Your own VPC, subnets, routes, and both firewall systems' },
  { n: 3, title: 'Run a Server', sub: 'A real web server, IAM roles, private access, and troubleshooting' },
  { n: 4, title: 'Build Private Infrastructure', sub: 'Private subnets, the connect-then-download problem, and NAT' },
  { n: 5, title: 'Build a Resilient Application', sub: 'Launch templates, target groups, ALB, health checks, auto-scaling' },
  { n: 6, title: 'Protect & Operate It', sub: 'HTTPS, WAF, CloudWatch, Flow Logs, and the big troubleshooting challenge' },
  { n: 7, title: 'Automate It', sub: 'CloudFormation, ending at the full client architecture' },
];

const all = (await getCollection('labs', ({ data }) => !data.draft))
  .sort((a, b) => a.data.number - b.data.number);

const byPhase = (p) => all.filter((l) => l.data.phase === p);
const typeTag = { lab: 'lab', concept: 'concept', challenge: 'challenge' };
---
<Base title="Roadmap, inthelab" path="/roadmap">
  <div class="rm-head wrap">
    <div class="kicker">// the roadmap</div>
    <h2>A roadmap for learning AWS by doing</h2>
    <p>The roadmap connects the AWS concepts that matter, in an order that makes sense. Start at the top and work your way to the bottom.</p>
  </div>

  <div class="rm wrap">
    {phases.map((ph) => {
      const labs = byPhase(ph.n);
      const isFirst = ph.n === 1;
      return (
        <div class={`phase ${isFirst ? 'open' : ''}`}>
          <button class="ph-head" onclick="this.parentElement.classList.toggle('open')">
            <div class="ph-idx">{ph.n}</div>
            <div class="ph-tw"><h3>{ph.title}</h3><div class="ph-sub">{ph.sub}</div></div>
            <div class="ph-count mono">{labs.length} labs</div>
            <svg class="ph-chev" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="ph-body">
            <div class="ph-inner">
              {labs.length === 0 && <div class="empty mono">Labs for this phase are being written.</div>}
              {labs.map((l) => (
                <a href={`/labs/${l.id}`} class="lab-row">
                  <span class="lr-num mono">{String(l.data.number).padStart(2,'0')}</span>
                  <div class="lr-main">
                    <div class="lr-title">{l.data.title}</div>
                    <div class="lr-sub">{l.data.summary}</div>
                  </div>
                  <span class={`lr-tag t-${l.data.type}`}>{typeTag[l.data.type]}</span>
                  <span class="lr-time mono">{l.data.time.replace('~','')}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      );
    })}
  </div>

  <style>
    .rm-head{padding:50px 0 6px;text-align:center}
    .rm-head h2{font-size:clamp(28px,4vw,42px);margin-bottom:12px}
    .rm-head p{color:var(--ink-dim);font-size:16.5px;max-width:560px;margin:0 auto}
    .rm{max-width:860px;padding-bottom:66px;display:flex;flex-direction:column;gap:11px;margin-top:28px}
    .phase{background:var(--canvas-2);border:1px solid var(--line);border-radius:var(--rad-lg);overflow:hidden;box-shadow:var(--sh-sm)}
    .ph-head{display:flex;align-items:center;gap:14px;padding:16px 19px;cursor:pointer;width:100%;background:none;border:none;font-family:inherit;text-align:left;color:var(--ink)}
    .ph-head:hover{background:var(--panel)}
    .ph-idx{width:36px;height:36px;border-radius:9px;background:var(--panel);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:15px;color:var(--ink-dim);flex:none}
    .phase.open .ph-idx{background:var(--accent-soft);color:var(--accent)}
    .ph-tw{flex:1;min-width:0}
    .ph-tw h3{font-size:17px;margin-bottom:2px}
    .ph-sub{font-size:13px;color:var(--ink-faint)}
    .ph-count{font-size:12px;color:var(--ink-faint);flex:none}
    .ph-chev{color:var(--ink-faint);transition:transform .25s;flex:none}
    .phase.open .ph-chev{transform:rotate(180deg)}
    .ph-body{max-height:0;overflow:hidden;transition:max-height .3s ease}
    .phase.open .ph-body{max-height:900px}
    .ph-inner{padding:2px 19px 17px}
    .lab-row{display:flex;align-items:center;gap:13px;padding:11px 13px;background:var(--canvas);border:1px solid var(--line);border-radius:10px;margin-top:7px;transition:.13s}
    [data-theme="dark"] .lab-row{background:var(--panel)}
    .lab-row:hover{border-color:var(--accent);transform:translateX(3px)}
    .lr-num{font-size:11px;color:var(--ink-faint);flex:none}
    .lr-main{flex:1;min-width:0}
    .lr-title{font-size:14px;font-weight:500}
    .lr-sub{font-size:12.5px;color:var(--ink-faint);margin-top:1px}
    .lr-tag{font-family:'JetBrains Mono',monospace;font-size:9.5px;padding:2px 7px;border-radius:5px;flex:none}
    .t-lab{background:var(--accent-soft);color:var(--accent)}
    .t-concept{background:color-mix(in srgb,var(--ok) 15%,transparent);color:var(--ok)}
    .t-challenge{background:var(--cost-soft);color:var(--cost)}
    .lr-time{font-size:11px;color:var(--ink-faint);flex:none;width:38px;text-align:right}
    .empty{font-size:13px;color:var(--ink-faint);padding:12px 4px}
  </style>
</Base>
