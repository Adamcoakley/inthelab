---
import { readFileSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import { getOrderedLabs } from '../lib/labs.js';
import { phases } from '../data/phases.js';

// Inline the home diagrams so they follow the light/dark theme.
const svg = (name) => readFileSync(`${process.cwd()}/public/images/home/${name}.svg`, 'utf8');

// Real numbers from the content, so this page never goes out of date.
const labs = (await getOrderedLabs()).filter((l) => phases.some((p) => p.number === l.data.phase));
const countFor = (n) => labs.filter((l) => l.data.phase === n).length;
const readyPhases = phases.filter((p) => countFor(p.number) > 0);
const lastReady = readyPhases.at(-1)?.number ?? 0;
const firstLab = labs[0];
const startHref = firstLab ? `/labs/${firstLab.id}` : '/roadmap';

const steps = [
  { file: 'step-build', title: 'You build something', text: 'Launch a real server, in a network you built yourself. Nothing is simulated.' },
  { file: 'step-break', title: "It doesn't work", text: "You try to connect and it times out. It's the same wall most people hit, and it's there on purpose." },
  { file: 'step-fix', title: 'You find out why', text: "One route was missing. Add it, and you'll never forget what a route table does." },
];

const path = [
  { title: 'Roadmap', text: 'Twelve phases, from how networks work to a production-shaped AWS architecture.', status: 'Start here', href: '/roadmap' },
  { title: 'Projects', text: "Build with services the roadmap doesn't cover, like hosting a website on S3.", status: 'Coming soon' },
  { title: 'Troubleshoot', text: 'Deploy a broken architecture and fix it yourself, with hints if you need them.', status: 'Coming soon' },
];

const costs = [
  { title: 'Start on the Free plan', text: "New AWS accounts get credits and can't be charged until you choose to upgrade. A mistake costs credits, not money." },
  { title: 'A budget alert comes first', text: 'The first AWS lab sets up an email alert before you build anything at all.' },
  { title: 'Every lab shows its cost', text: 'Right at the top, before you start.', pill: '$ ~$0.02 an hour while running' },
  { title: 'Every lab ends with a cleanup', text: "You're told exactly what to delete, and what to keep for the next lab." },
];
---
<Base title="inthelab: learn AWS by actually using it" path="/">

  <!-- ============================================================ hero -->
  <section class="hero wrap">
    <div class="hero-text">
      <h1>Learn AWS by actually using it.</h1>
      <p class="lede">Hands-on labs in your own AWS account. You'll build real infrastructure, run into the same problems everyone does, and find out why they happen.</p>
      <div class="actions">
        <a class="btn-primary" href={startHref}>Start with Phase 0</a>
        <a class="btn-ghost" href="/roadmap">See the roadmap</a>
      </div>
      <p class="meta">{labs.length} labs ready so far, across Phases 0 to {lastReady}. No sign-up needed.</p>
    </div>
    <figure class="diagram hero-diagram">
      <Fragment set:html={svg('hero')} />
      <figcaption class="dcap" id="hero-cap" aria-live="polite">You've launched a server. Can you reach it?</figcaption>
    </figure>
  </section>

  <!-- ============================================================ method -->
  <section class="block wrap">
    <div class="head">
      <h2>Build it, break it, understand it</h2>
      <p>Most tutorials hand you a finished setup and explain the parts. Here, things fail first, so the fix actually means something.</p>
    </div>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step">
          <div class="step-art diagram" set:html={svg(s.file)} />
          <div class="step-num" aria-hidden="true">{i + 1}</div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- ============================================================ path -->
  <section class="block wrap">
    <div class="head">
      <h2>Your path</h2>
      <p>Follow the roadmap first. It teaches the networking and AWS fundamentals that everything else depends on.</p>
    </div>
    <ol class="path">
      {path.map((p, i) => (
        <li class={`path-card ${p.href ? 'is-live' : ''}`}>
          <div class="path-top">
            <span class="path-num" aria-hidden="true">{i + 1}</span>
            <span class={`status ${p.href ? 'live' : 'soon'}`}>{p.status}</span>
          </div>
          <h3>{p.href ? <a href={p.href}>{p.title}</a> : p.title}</h3>
          <p>{p.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- ============================================================ destination -->
  <section class="block wrap">
    <div class="head">
      <h2>Where you'll end up</h2>
      <p>By the last phase, you'll build this from scratch, and you'll know why every piece is there.</p>
    </div>
    <figure class="diagram final">
      <Fragment set:html={svg('final-architecture')} />
      <figcaption class="dcap">DNS, HTTPS and a firewall in front of a load balancer, with servers in private subnets across two Availability Zones</figcaption>
    </figure>
    <div class="teaser">
      <p><b>{phases.length} phases</b> get you there, from your first network to a production-ready setup. Each one builds on the last.</p>
      <a class="btn-ghost" href="/roadmap">See the full roadmap</a>
    </div>
  </section>

  <!-- ============================================================ cost -->
  <section class="block wrap">
    <div class="head">
      <h2>Worried about the bill?</h2>
      <p>Fair enough: surprise AWS bills are real. The course is built so you stay in control.</p>
    </div>
    <div class="costs">
      {costs.map((c) => (
        <div class="cost">
          <h3>{c.title}</h3>
          <p>{c.text}</p>
          {c.pill && <span class="cost-pill mono">{c.pill}</span>}
        </div>
      ))}
    </div>
  </section>

  <!-- ============================================================ closing -->
  <section class="closing wrap">
    <h2>Start with how networks actually work</h2>
    <p>Phase 0 doesn't need an AWS account. You'll learn what a server, an IP address, a route and a firewall really are, then use all of it in AWS.</p>
    <a class="btn-primary" href={startHref}>Start Phase 0</a>
  </section>

  <style>
    .hero{display:grid;grid-template-columns:1fr 1.05fr;gap:48px;align-items:center;padding-top:64px;padding-bottom:40px}
    .hero h1{font-size:clamp(36px,5vw,56px);font-weight:700;letter-spacing:-.03em;line-height:1.05;margin-bottom:18px}
    .lede{font-size:18px;color:var(--ink-dim);max-width:44ch;line-height:1.6;margin-bottom:26px}
    .actions{display:flex;gap:12px;flex-wrap:wrap}
    .meta{margin-top:18px;font-size:14px;color:var(--ink-faint)}
    .hero-diagram{margin:0}
    .hero-diagram .dcap{min-height:1.5em;transition:color .3s}

    .block{padding-top:56px;padding-bottom:16px}
    .head{max-width:620px;margin-bottom:28px}
    .head h2{font-size:clamp(26px,3.2vw,34px);margin-bottom:10px}
    .head p{color:var(--ink-dim);font-size:16.5px;line-height:1.6}

    .steps{list-style:none;display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
    .step-art{margin:0 0 14px;padding:12px}
    .step-num{width:26px;height:26px;border-radius:50%;background:var(--ink);color:var(--canvas);font-weight:700;font-size:13px;display:grid;place-items:center;margin-bottom:10px}
    .step h3{font-size:18px;margin-bottom:6px}
    .step p{color:var(--ink-dim);font-size:15px;line-height:1.6}

    .path{list-style:none;display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
    .path-card{border:1px solid var(--line);border-radius:var(--rad);padding:20px;background:var(--canvas-2)}
    .path-card.is-live{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
    .path-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
    .path-num{width:26px;height:26px;border-radius:50%;border:1.5px solid var(--ink-faint);color:var(--ink-dim);font-weight:700;font-size:13px;display:grid;place-items:center}
    .is-live .path-num{background:var(--accent);border-color:var(--accent);color:#fff}
    .status{font-size:12.5px;font-weight:600;padding:3px 10px;border-radius:100px}
    .status.live{background:var(--accent-soft);color:var(--accent)}
    .status.soon{background:var(--panel);color:var(--ink-faint)}
    .path-card h3{font-size:18px;margin-bottom:6px}
    .path-card h3 a{color:var(--ink)}
    .path-card h3 a:hover{color:var(--accent)}
    .path-card p{color:var(--ink-dim);font-size:15px;line-height:1.6}

    .final{margin:0 0 20px}
    .final :global(svg){max-width:760px;margin:0 auto}
    .teaser{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;padding:18px 22px;border:1px solid var(--line);border-radius:var(--rad);background:var(--canvas-2)}
    .teaser p{margin:0;color:var(--ink-dim);font-size:15px;max-width:56ch}
    .teaser b{color:var(--ink)}

    .costs{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
    .cost{border:1px solid var(--line);border-radius:var(--rad);padding:20px;background:var(--canvas-2)}
    .cost h3{font-size:17px;margin-bottom:6px}
    .cost p{color:var(--ink-dim);font-size:15px;line-height:1.6}
    .cost-pill{display:inline-block;margin-top:10px;font-size:12.5px;padding:5px 11px;border-radius:8px;background:var(--panel);border:1px solid var(--line);color:var(--cost)}

    .closing{text-align:center;padding-top:72px;padding-bottom:40px;max-width:680px}
    .closing h2{font-size:clamp(26px,3.2vw,34px);margin-bottom:12px}
    .closing p{color:var(--ink-dim);font-size:16.5px;line-height:1.6;margin:0 auto 24px;max-width:56ch}

    @media (max-width:900px){
      .hero{grid-template-columns:1fr;gap:28px;padding-top:36px}
      .steps,.path{grid-template-columns:1fr}
      .costs{grid-template-columns:1fr}
    }
    @media (max-width:560px){
      .teaser{padding:16px}
    }
  </style>

  <!-- The hero's one animated moment: the server can't be reached, then one route fixes it. -->
  <script is:inline>
    (function () {
      var fig = document.querySelector('.hero-diagram');
      var svg = fig && fig.querySelector('svg');
      var cap = document.getElementById('hero-cap');
      if (!svg || !cap) return;
      var el = function (id) { return svg.querySelector('#' + id); };
      var packet = el('packet'), fail = el('fail'), pass = el('pass'), missing = el('route-missing'), added = el('route-added');
      [fail, pass, missing, added].forEach(function (g) { g.style.transition = 'opacity .45s'; });
      var show = function (g, on) { g.style.opacity = on ? '1' : '0'; };
      var say = function (text, tone) { cap.textContent = text; cap.style.color = tone ? 'var(--dg-' + tone + ')' : ''; };

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        show(missing, false); show(added, true); show(pass, true);
        say('One missing route was the problem. Add it, and it connects.', 'ok');
        return;
      }
      var wait = function (ms) { return new Promise(function (r) { setTimeout(r, ms); }); };
      var move = function (from, to, ms) {
        return new Promise(function (resolve) {
          var t0 = null;
          packet.setAttribute('opacity', '1');
          function frame(t) {
            if (!t0) t0 = t;
            var k = Math.min(1, (t - t0) / ms);
            packet.setAttribute('cx', String(from + (to - from) * k));
            if (k < 1) requestAnimationFrame(frame); else { packet.setAttribute('opacity', '0'); resolve(); }
          }
          requestAnimationFrame(frame);
        });
      };
      async function loop() {
        while (true) {
          show(missing, true); show(added, false); show(fail, false); show(pass, false);
          say("You've launched a server. Can you reach it?");
          await wait(1200);
          await move(66, 154, 1100);
          show(fail, true);
          say('It times out, and nothing tells you why.', 'bad');
          await wait(2200);
          show(fail, false); show(missing, false); show(added, true);
          say('The subnet has no route out. Add one.');
          await wait(1800);
          await move(66, 386, 1700);
          show(pass, true);
          say("Now it connects, and you'll never forget why.", 'ok');
          await wait(3200);
        }
      }
      loop();
    })();
  </script>
</Base>
